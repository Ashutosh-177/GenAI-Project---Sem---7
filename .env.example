# --- LLM: Claude (Anthropic) ---
# Powers document drafting, conversational Q&A, summarization, and
# ingest-time document classification. Get a key at console.anthropic.com.
ANTHROPIC_API_KEY=sk-ant-...
# claude-sonnet-5 (cheaper, default) or claude-opus-5 (higher quality, ~5x cost)
ANTHROPIC_MODEL=claude-sonnet-5

# --- OCR ---
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# --- Vector store (Qdrant) ---
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=qci_knowledge_hub
# "local"  -> embedded, file-based Qdrant, no Docker needed (quick start)
# "server" -> talk to a real Qdrant container at QDRANT_HOST:QDRANT_PORT
QDRANT_MODE=local
QDRANT_LOCAL_PATH=./qdrant_storage

# --- Embeddings ---
EMBEDDING_MODEL=intfloat/multilingual-e5-large

# --- Chunking ---
CHUNK_SIZE_CHARS=1000
CHUNK_OVERLAP_CHARS=150

# --- OCR fallback threshold ---
OCR_FALLBACK_CHAR_THRESHOLD=40

# --- RAG / guardrails ---
RETRIEVAL_TOP_K=5
RETRIEVAL_SCORE_THRESHOLD=0.78
AUDIT_LOG_PATH=./data/processed/audit_log.jsonl
MAX_FILE_SIZE_BYTES=209715200

# --- Voice input (faster-whisper, English only) ---
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# --- Optional: push access for scripts that commit/push on your behalf ---
# github_pat_token=ghp_...
